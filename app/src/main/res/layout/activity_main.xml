<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ============ 规则库管理 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 替换库（多配置）"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <Spinner
            android:id="@+id/spinner_library"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_new_library"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="＋ 新建库"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_rename_library"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✏️ 重命名"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_delete_library"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑️ 删库"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TonalButton" />
        </LinearLayout>

        <!-- ============ 规则列表 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="🔧 规则列表"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <TextView
            android:id="@+id/tv_rule_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/container_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_add_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="➕ 添加一条规则"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- ============ 输入区 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="📝 输入文本（粘贴或编辑）"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <Button
            android:id="@+id/btn_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="📂 从文件读取"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.TonalButton" />

        <EditText
            android:id="@+id/et_input"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="在此粘贴要处理的文本…"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:padding="10dp"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入编码："
                android:textColor="#334155" />

            <Spinner
                android:id="@+id/spinner_in_encoding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="输出编码："
                android:textColor="#334155" />

            <Spinner
                android:id="@+id/spinner_out_encoding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_replace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/accent"
            android:text="🚀 执行替换"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- ============ 输出区 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="✅ 替换结果"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <EditText
            android:id="@+id/et_output"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="替换后的结果…"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:padding="10dp"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 复制"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="💾 保存为文件"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="就绪"
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
